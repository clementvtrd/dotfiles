{
  "mcpServers": {
    "github": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": {{ .github_pat | quote }}
      }
    },
    "context7": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": {{ printf "Bearer %s" .context7 | quote }}
      }
    },
    "playwright": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}