{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh label *)",
      "Bash(make *)",
      "Bash(rtk find *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk git add *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git diff)",
      "Bash(rtk git grep *)",
      "Bash(rtk git grep)",
      "Bash(rtk git log *)",
      "Bash(rtk git log)",
      "Bash(rtk git rev-parse *)",
      "Bash(rtk git show *)",
      "Bash(rtk git show)",
      "Bash(rtk git status *)",
      "Bash(rtk git status)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk make *)",
      "Bash(rtk read *)",
      "Bash(rtk wc *)",
      "Read(/Users/clementvtrd/.claude/plugins/cache/**)"
    ],
    "deny": [
      "Edit(.env.*)",
      "Edit(.env)",
      "Edit(*.env)",
      "Read(.env.*)",
      "Read(.env)",
      "Read(*.env)",
      "Edit(.git)",
      "Read(.git)",
      "Edit(.git/**)",
      "Read(.git/**)"
    ],
    "ask": [
      "Bash(rtk git commit *)",
      "Bash(rtk git push)",
      "Edit(Makefile)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "disableSkillShellExecution": false,
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "claude-hud@claude-hud": true,
    "php-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "xhigh",
  "model": "opus[1m]",
  "voice": {
    "enabled": true,
    "mode": "hold",
    "autoSubmit": true
  },
  "theme": "auto",
  "voiceEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size 2>/dev/null </dev/tty | awk '\"'\"'{print $2}'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/Users/clementvtrd/.nvm/versions/node/v24.14.0/bin/node\" \"${plugin_dir}dist/index.js\"'",
    "refreshInterval": 5
  }
}
