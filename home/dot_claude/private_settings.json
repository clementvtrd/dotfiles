{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh label *)",
      "Bash(make *)",
      "Bash(rtk find *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk git add *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git diff)",
      "Bash(rtk git grep *)",
      "Bash(rtk git grep)",
      "Bash(rtk git log *)",
      "Bash(rtk git log)",
      "Bash(rtk git rev-parse *)",
      "Bash(rtk git show *)",
      "Bash(rtk git show)",
      "Bash(rtk git status *)",
      "Bash(rtk git status)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk make *)",
      "Bash(rtk read *)",
      "Bash(rtk wc *)",
      "Read(/Users/clementvtrd/.claude/plugins/cache/**)"
    ],
    "deny": [
      "Edit(.env.*)",
      "Edit(.env)",
      "Edit(*.env)",
      "Read(.env.*)",
      "Read(.env)",
      "Read(*.env)",
      "Edit(.git)",
      "Read(.git)",
      "Edit(.git/**)",
      "Read(.git/**)"
    ],
    "ask": [
      "Bash(rtk git commit *)",
      "Bash(rtk git push)",
      "Edit(Makefile)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "disableSkillShellExecution": false,
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold",
    "autoSubmit": true
  },
  "theme": "auto",
  "voiceEnabled": true,
  "skipWorkflowUsageWarning": true
}
