{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "permissions": {
    "defaultMode": "acceptEdits",
    "ask": [
      "Bash(rtk git commit *)",
      "Edit(Makefile)",
      "Write(Makefile)"
    ],
    "allow": [
      "Bash(git rev-parse --show-toplevel)",
      "Bash(make *)",
      "Bash(obsidian *)",
      "Bash(python3 ~/.claude/skills/obs-daily/scripts/log_day.py)",
      "Bash(rtk find *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git diff)",
      "Bash(rtk git grep *)",
      "Bash(rtk git grep)",
      "Bash(rtk git log *)",
      "Bash(rtk git log)",
      "Bash(rtk git show *)",
      "Bash(rtk git show)",
      "Bash(rtk git status *)",
      "Bash(rtk git status)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk make *)",
      "Bash(rtk read *)",
      "Edit(/Users/clementvtrd/.claude/plugins/cache/**)",
      "Read(/Users/clementvtrd/.claude/plugins/cache/**)",
      "Write(/Users/clementvtrd/.claude/plugins/cache/**)"
    ],
    "deny": [
      "Bash(cat *)",
      "Edit(.env.*)",
      "Edit(.env)",
      "Edit(*.env)",
      "Read(.env.*)",
      "Read(.env)",
      "Read(*.env)",
      "Write(.env.*)",
      "Write(.env)",
      "Write(*.env)",
      "Edit(.git)",
      "Read(.git)",
      "Write(.git)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  }
}