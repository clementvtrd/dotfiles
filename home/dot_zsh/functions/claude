claude() {
  local name="${${PWD:t}//[^a-zA-Z0-9.-]/-}"
  local shell=0
  [[ $1 == (-s|--shell) ]] && { shell=1; shift }

  if sbx ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx -- "$name"; then
    if (( shell )); then
      sbx exec -it "$name" "${@:-bash}"
    else
      sbx run --name "$name" "$@"
    fi
    return
  fi

  if (( shell )); then
    print -u2 "claude: no sandbox '$name' yet; run 'claude' first"
    return 1
  fi

  local -a want=(github mermaid) have=() args=()
  local s
  for s in $want; do
    sbx mcp inspect $s >/dev/null 2>&1 && have+=($s)
  done
  (( $#have )) && args=(--static-mcp ${(j:,:)have})

  sbx run "$HOME/.config/sbx/claude-kit" --name "$name" $args "$@"
}
